NODE_ENV=development

# API
API_PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# Infrastructure (matches docker-compose.yml)
DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness_connect
REDIS_URL=redis://localhost:6379

# Development-only authentication. Never set in production.
JWT_DEV_SECRET=change-me-dev-only

# Where the Angular dev servers proxy /api to (default http://localhost:3000).
# The dev servers do not read this file: set these in the shell, for example
#   API_MOCK=true pnpm nx serve client-web   (uses the Prism mock on http://localhost:4010)
API_TARGET=http://localhost:3000
API_MOCK=false
