# The API validates these at startup and refuses to start when one is invalid.
# Required, no default: development | test | production. In production the dev login route is not registered.
NODE_ENV=development

# API
# Port the API listens on (default 3000). The global prefix is /v1.
API_PORT=3000
# Comma separated CORS allow-list. Origins not listed get no CORS headers.
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# Infrastructure (matches docker-compose.yml)
# Required. Integration tests use fitness_connect_test* databases on this same server
# and never touch the database named here.
DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness_connect
REDIS_URL=redis://localhost:6379

# Development-only authentication (HS256 secret of the tokens from POST /v1/dev/login).
# Required (at least 32 characters) unless NODE_ENV=production; the API refuses to start if it is set in production.
JWT_DEV_SECRET=change-me-dev-only-at-least-32-characters

# Where the Angular dev servers proxy /api to. The dev servers do not read this file:
# set these in the shell. Both lines are optional; the defaults are shown.
#   pnpm nx serve client-web                 -> API_TARGET (http://localhost:3000)
#   API_MOCK=true pnpm nx serve client-web   -> API_MOCK_TARGET (the Prism mock, http://localhost:4010)
# API_TARGET=http://localhost:3000
# API_MOCK_TARGET=http://localhost:4010
